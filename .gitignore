.env
.env.*
!.env.example
.dev.vars
# A worktree links its packages in as a symlink, which "node_modules/" (directories only) misses.
node_modules
.cache/
.vercel/
.claude/worktrees/
.DS_Store
.claude/settings.local.json

# The owner's own config lives in the config store, not in git (D296). `singularity config pull`
# fills these from the store, or from config/examples when the store is off.
/config/sources.user.json
/config/topics.json
/config/queries.json
/config/preferences.json
/config/schedule.json
/config/structure.json
/config/writer.json
/config/profiles/
# The run state lives in Postgres, not git (D300 step 3, D381). Jobs fill state/ with `singularity state
# pull` and send their changes back with `state push`; the saved copy of each file is a row of
# state_documents. Rollback: `singularity state pull` into a checkout.
/state/

# Digests and episodes live in the content store, not in git (D300 step 2b). Jobs fill them with
# `singularity content pull --track` and send their changes back with `content push`; the site build
# pulls them first (scripts/pullContent.ts).
/Digests/
/Podcasts/
# The stories each recent run gathered, for a rewrite to carry (D376).
/Pools/
