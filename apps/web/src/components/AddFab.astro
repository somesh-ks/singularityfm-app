---
import Fab from "@singularityfm/design-system/Fab";

interface Props {
  /** What a press adds, for a screen reader ("Add a category or a source"). */
  label: string;
  /** The topic a new source goes under; left out, the panel opens on a new topic. */
  source?: string;
}

const { label, source } = Astro.props;
---

{/* A page's add action below 64rem, as Android draws a screen's primary action: the shape, place and
     folding of the New episode button (fab.css, fabScroll.ts), the plus and "Add". From
     64rem the same action is a button in the page itself, beside the search (2026-10-20). The topics
     editor opens the panel from it as from any Add (data-add-topic or data-add-source). */}
<Fab
  label={label}
  icon="plus"
  className="add-fab"
  data-add-topic={source === undefined ? "" : undefined}
  data-add-source={source}
  data-sound="open"
  data-needs-js
>Add</Fab>
