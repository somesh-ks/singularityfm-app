---
import Button from "@singularityfm/design-system/Button";
import Chip from "@singularityfm/design-system/Chip";
import ChipGroup from "@singularityfm/design-system/ChipGroup";
import Field from "@singularityfm/design-system/Field";
import Icon from "@singularityfm/design-system/Icon";
import SegmentedChoice from "@singularityfm/design-system/SegmentedChoice";
import Select from "@singularityfm/design-system/Select";
import {
  DEFAULTS,
  FORMATS,
  LENGTHS,
  MAX_TITLE_CHARS,
  MORE_OPTIONS_TEMPLATE,
  moreOptionsSummary,
  submitLabel,
  TONES,
  topicOptions,
  WINDOWS,
} from "../lib/createForm";
import { CRASHED, INVALID, OFFLINE_RETRY } from "../lib/failureCopy";
import { loadManage } from "../lib/manage";
import { loadScheduleView } from "../lib/schedule";
import { heldStory, storyOptions } from "../lib/storyOptions";
// The layout renders this form for the Create sheet on every page, so these styles are global. The
// build links them before the layout's own stylesheets, so their rules never rely on coming last:
// where one adjusts a shared rule, it does so with a more specific selector.
import "../styles/settings.css";
import "@singularityfm/design-system/styles/picker.css";
import "../styles/create.css";

const { sections, topics: allTopics } = await loadManage();
// What the panel starts from: the custom defaults in config/schedule.json (type, length, voices, and
// the topics out of the Custom scope, which it does not offer).
const { custom } = await loadScheduleView();
const topics = topicOptions(sections, allTopics, custom.skip_topics);
const startFormat = custom.format;
const startLength = custom.length_minutes;
// A count saved before the fives (12) is offered and shown; one Auto now equals shows as Auto.
const storyChoices = storyOptions(startLength, custom.stories ?? undefined);
const startStories = heldStory(storyChoices, String(custom.stories ?? ""));
// A readout's one select is "Voice"; in a discussion each select is a host's voice.
const VOICES = [
  {
    name: "voice",
    saved: custom.voice_id,
    label: "Voice",
    caption: "Primary voice",
    hostLabel: "Primary voice",
    index: "a",
  },
  {
    name: "voice_b",
    saved: custom.voice_id_b,
    label: "Secondary voice",
    caption: "Secondary voice",
    hostLabel: "Secondary voice",
    index: "b",
  },
] as const;
// A declaration, not a generic arrow: the Astro compiler reads `<T>(` as a tag.
function labelOf<T>(list: ReadonlyArray<{ value: T; label: string }>, value: T): string {
  return list.find((item) => item.value === value)?.label ?? "";
}
// The More options line before the script runs: the same words the script writes (createPage.ts).
const moreSummary = moreOptionsSummary(
  labelOf(FORMATS, startFormat),
  labelOf(TONES, DEFAULTS.tone),
);

// Every sentence the form's script can show lives here, in the markup, not in the script. The
// script picks one by its key, which keeps it small. The run's own lines are in RunStatus.astro.
const COPY = {
  topics: "Pick at least one category.",
  "400": INVALID,
  cooldown: "You can make another episode in",
  daily_cap: "That's today's limit. Try again in",
  // Shown on the button while the request is out, in place of its words.
  starting: "Starting…",
  // A 5xx: the server logged why, and the reference it sent is added to this (lib/errorRef.ts).
  "503": "Something broke on our side, so no episode was started.",
  // A 5xx that is not the site's own answer: the function crashed (lib/errorRef.ts).
  crashed: CRASHED,
  network: OFFLINE_RETRY,
} as const;
---

{/* The one Create form. /create renders it in the page; the layout renders it into a template that
     the sheet clones on first open. A page never renders both, so its ids stay unique. */}
<div class="create-view" data-create>
  <form data-create-form novalidate>
    {/* Every episode is written for the owner (the General audience is retired, 2026-10-14): the
         request still says so, from this field. */}
    <input type="hidden" name="audience" value={DEFAULTS.audience} />

    <section class="create-group">
      <h2 class="section-head text-heading">
        <label for="create-title">Title <span class="create-optional">(optional)</span></label>
      </h2>
      <Field
        className="create-title"
        id="create-title"
        name="title"
        type="text"
        maxLength={MAX_TITLE_CHARS}
        autoComplete="off"
        enterKeyHint="done"
      />
    </section>

    {/* What the episode is about is the one question without an answer. Length and how far back
         to look follow; the rest has a default and waits under More options, whose line says what
         those defaults are. */}
    <section class="create-group create-group-primary" aria-labelledby="create-topics-label">
      <h2 class="section-head text-heading" id="create-topics-label">Categories</h2>
      <ChipGroup aria-labelledby="create-topics-label" data-built-topics={allTopics.map((topic) => topic.id).join(" ")}>
        {
          topics.map((topic) => (
            <Chip name="topic" value={topic.value} data-ids={topic.ids.join(" ")} defaultChecked={topic.ticked}>
              {topic.label}
            </Chip>
          ))
        }
      </ChipGroup>
      <p class="create-error" role="alert" data-error="topics" hidden>
        <Icon name="alert" /><span></span>
      </p>
    </section>

    <section class="create-group" aria-labelledby="create-length-label">
      <h2 class="section-head text-heading" id="create-length-label">Max length</h2>
      <SegmentedChoice
        className="create-choice"
        aria-labelledby="create-length-label"
        name="length"
        options={LENGTHS.map((length) => ({ value: String(length.value), label: length.label }))}
        defaultValue={String(startLength)}
      />
    </section>

    {/* Beside Length (D377): a count above Auto shortens each story to fit. The script keeps the
         list to what the length holds (createPage.ts). */}
    <section class="create-group" aria-labelledby="create-stories-label">
      <h2 class="section-head text-heading" id="create-stories-label">
        <label for="create-stories">Stories</label>
      </h2>
      <Select id="create-stories" name="stories" data-saved={startStories} data-wheel autoComplete="off">
        {
          storyChoices.map((entry) => (
            <option value={entry.value} data-wheel-text={entry.wheel} hidden={entry.hidden} disabled={entry.hidden} selected={entry.value === startStories}>
              {entry.label}
            </option>
          ))
        }
      </Select>
    </section>

    <section class="create-group" aria-labelledby="create-window-label">
      <h2 class="section-head text-heading" id="create-window-label">Look back</h2>
      <SegmentedChoice
        className="create-choice"
        aria-labelledby="create-window-label"
        name="window"
        options={WINDOWS.map((window) => ({ value: String(window.value), label: window.label, "data-label": window.label }))}
        defaultValue={String(DEFAULTS.window)}
      />
    </section>

    {/* Everything with a sensible default, in place: one row that names the current choices and
         opens to show them, at every width (D345). */}
    <details class="create-more" data-create-more>
      <summary class="create-more-summary">
        <span class="create-more-text">
          <span class="create-more-title">More options</span>
          <span class="create-more-values" data-more-values data-template={MORE_OPTIONS_TEMPLATE}>{moreSummary}</span>
        </span>
        <Icon name="chevronDown" className="create-more-chevron" />
      </summary>
      <div class="create-more-body">
        <section class="create-group" aria-labelledby="create-format-label">
          <h2 class="section-head text-heading" id="create-format-label">Format</h2>
          <SegmentedChoice
            className="create-choice"
            aria-labelledby="create-format-label"
            name="format"
            options={FORMATS.map((format) => ({ value: format.value, label: format.label, "data-label": format.label }))}
            defaultValue={startFormat}
          />
        </section>

        {/* A readout has one voice; a discussion has two hosts, each with a voice. The options come from
             /api/voices when the form is first used, so the markup carries only the default and the
             saved voice. Each voice can be heard from its list before the episode is made. */}
        <section class="create-group" aria-labelledby="create-voice-label">
          <h2 class="section-head text-heading" id="create-voice-label" data-voice-heading data-one="Voice" data-two="Voices">{startFormat === "discussion" ? "Voices" : "Voice"}</h2>
          <div class="create-voices">
            {
              VOICES.map((voice, index) => (
                <div class="create-voice" data-voice={voice.name} hidden={index === 1 && startFormat !== "discussion"}>
                  <label class="create-voice-name" for={`create-${voice.name}`} data-voice-caption data-host={voice.index} data-unnamed={voice.caption} data-named="{name}'s voice" hidden={startFormat !== "discussion"}>{voice.caption}</label>
                  <div class="create-voice-field">
                    <Select
                      className="create-voice-select"
                      id={`create-${voice.name}`}
                      name={voice.name}
                      data-saved={voice.saved ?? ""}
                      data-one={voice.label}
                      data-two={voice.hostLabel}
                      data-two-named="{name}'s voice"
                      data-picker="voice"
                      aria-label={startFormat === "discussion" ? voice.hostLabel : voice.label}
                      autoComplete="off"
                    >
                      <option value="">Default</option>
                      {voice.saved && <option value={voice.saved} selected>Saved voice</option>}
                    </Select>
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <section class="create-group" aria-labelledby="create-tone-label">
          <h2 class="section-head text-heading" id="create-tone-label">Tone</h2>
          <SegmentedChoice
            className="create-choice"
            aria-labelledby="create-tone-label"
            name="tone"
            options={TONES.map((tone) => ({ value: tone.value, label: tone.label, "data-label": tone.label }))}
            defaultValue={DEFAULTS.tone}
          />
        </section>

      </div>
    </details>

    {/* The words are in their own span, so the length can change them without removing the spinner
         that shows while the request is out. */}
    <div class="create-submit">
      <Button variant="filled" type="submit" data-submit>
        <span class="spinner" aria-hidden="true"></span>
        <span data-submit-text>{submitLabel()}</span>
      </Button>
      <p class="create-error" role="alert" data-error="form" hidden>
        <Icon name="alert" /><span></span>
      </p>
    </div>
  </form>

  <div hidden data-copy>
    {Object.entries(COPY).map(([key, text]) => <p data-k={key}>{text}</p>)}
  </div>
</div>
