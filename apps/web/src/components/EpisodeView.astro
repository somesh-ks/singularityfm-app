---
import ChapterAside from "@singularityfm/design-system/ChapterAside";
import Link from "@singularityfm/design-system/Link";
import type { AlbumOption } from "../lib/catchUps";
import { episodeCover } from "../lib/covers";
import { storyCount } from "../lib/digestView";
import { episodeSections } from "../lib/episodeHighlights";
import { type EpisodeEntry, episodeLength } from "../lib/episodes";
import { headlineParts, madeAt } from "../lib/format";
import { CATCH_UP_LABEL } from "../lib/formatLabels";
import { episodeFacts } from "../lib/libraryCard";
import type { SectionRef } from "../lib/sectionLabel";
import { sharedPlayer, sharedTarget } from "../lib/share";
import AmbientLight from "./AmbientLight.astro";
import Chapter from "./Chapter.astro";
import Cover from "./Cover.astro";
import EpisodeActions from "./EpisodeActions.astro";
import HeroMarks from "./HeroMarks.astro";
import PlayCta from "./PlayCta.astro";
import PlayerData from "./PlayerData.astro";
import PodcastStrip from "./PodcastStrip.astro";
import StoryControls from "./StoryControls.astro";
import "../styles/episode.css";

interface Props {
  entry: EpisodeEntry;
  /** Briefing summaries by item id: a story an episode shares with a briefing is summed up so. */
  summaries?: ReadonlyMap<string, string>;
  /** Briefing topics by item id: the topic a vote on a story the episode shares with a briefing names. */
  topics?: ReadonlyMap<string, string>;
  /** Briefing sections by item id: the highlights are grouped under them (highlightSections). */
  sections?: ReadonlyMap<string, SectionRef>;
  /** The day's Catch ups when it has two or more (D219): a select before Play moves between them. */
  album?: readonly AlbumOption[];
  /** Set on a shared page, /s/<token> (D153): no owner actions, and Play goes through the link. */
  shareToken?: string;
}

const { entry, summaries, topics, sections: sectionOf, album, shareToken } = Astro.props;
const { episode } = entry;
const length = episodeLength(episode);
const sections = episodeSections(episode, { summaries, sections: sectionOf });
// A story only the episode covers takes the episode's first topic.
const fallbackTopic = episode.request.topic_ids[0] ?? "general";
---

<main
  id="main"
  tabindex="-1"
  data-digest-id={entry.id}
  data-digest-date={episode.date}
  data-latest="false"
  data-shared={shareToken ? "" : undefined}
>
  <header class="hero">
    <AmbientLight cover={episodeCover(entry)} />
    <Cover
      digestId={entry.id}
      size="hero"
      source={episodeCover(entry)}
      weekly={false}
    />
    <div class="hero-text">
      <h1 class="page-title text-display" id="page-title" tabindex="-1">{episode.title}</h1>
      {/* As a briefing's facts ("Weekly · 12 stories"): the date is on the cover. */}
      <p class="meta hero-facts" data-played-id={entry.id}>
        <span>{CATCH_UP_LABEL}</span><span>{storyCount(episode.sources.length)}</span><HeroMarks />
      </p>
    </div>
    {/* The same path a briefing takes: audio is made when Play is pressed, one turn at a time. */}
    <PlayCta
      digestId={entry.id}
      mode="preparing"
      length={length}
      noun="episode"
      share={sharedTarget(entry.id, "episode", shareToken)}
      album={shareToken ? undefined : album}
      favorite={shareToken ? undefined : entry.id}
      menu={shareToken
        ? undefined
        : {
            episodeId: entry.id,
            minutes: episode.request.length_minutes,
            stories: episode.sources.length,
            regenerations: episode.regenerations,
            page: {
              id: entry.id,
              title: episode.title,
              subtitle: episodeFacts(entry).line,
              path: `/e/${entry.id}`,
              audio: `/api/narrate?digest=${encodeURIComponent(entry.id)}`,
            },
          }}
    />
  </header>

  {!shareToken && <EpisodeActions id={entry.id} selected={episode.request.topic_ids} />}

  {/* The script is read in the player. The page is for the news itself: each story the episode
       covers, what was said about it, and the way to the source, grouped by section as a briefing
       is, under the same name strip (PodcastStrip.astro), with its contents column from two sections. */}
  {
    sections.length > 0 && (
      <div class="briefing" id="briefing">
        <PodcastStrip id={entry.id} title={episode.title} cover={episodeCover(entry)} />
        {sections.map((section) => (
          <Chapter section={section}>
            {section.highlights.map((highlight) => (
              <article class="episode-highlight">
                {/* The headline is the link to the source, and the publisher above it is its quiet
                    attribution. A Catchup's script has no start time for a story, so there is no
                    time to press here as a briefing's story has (Item.astro, D403). */}
                {highlight.host && (
                  <Link
                    variant="source"
                    className="story-source episode-highlight-link"
                    href={highlight.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    tabIndex={-1}
                    aria-hidden="true"
                    title={highlight.publisher ?? undefined}
                  >{highlight.publisher}</Link>
                )}
                <h3 class="episode-highlight-title text-title">
                  {highlight.host ? (
                    <a class="story-link" href={highlight.url} target="_blank" rel="noopener noreferrer">
                      {headlineParts(highlight.headline).map((part) =>
                        part.nowrap ? <span class="no-break">{part.text}</span> : part.text,
                      )}
                      <span class="sr-only">(opens in a new tab)</span>
                    </a>
                  ) : (
                    headlineParts(highlight.headline).map((part) =>
                      part.nowrap ? <span class="no-break">{part.text}</span> : part.text,
                    )
                  )}
                </h3>
                {highlight.text && <p class="episode-highlight-text">{highlight.text}</p>}
                <div class="story-actions episode-highlight-actions">
                  <StoryControls
                    id={highlight.itemId}
                    url={highlight.url}
                    headline={highlight.headline}
                    topic={topics?.get(highlight.itemId) ?? fallbackTopic}
                    source={highlight.source}
                    outlet={highlight.publisher}
                    canBlock={highlight.host !== null}
                  />
                </div>
              </article>
            ))}
          </Chapter>
        ))}
      </div>
    )
  }
  <p class="meta page-made"><time datetime={episode.generated_at}>{madeAt(episode.generated_at)}</time></p>
  <PlayerData data={sharedPlayer(entry.player, shareToken)} />
</main>
{/* After main, as on a briefing: the contents column sits past the reading column. */}
{sections.length > 1 && <ChapterAside sections={sections} />}

<script>
  // Shared with the briefing pages: it shares the page's address.
  void import("../scripts/briefingPage");
  import { installCatchUpAlbum } from "../scripts/catchUpAlbum";
  import { installEpisodeActions } from "../scripts/episodeActionsEntry";

  installEpisodeActions();
  installCatchUpAlbum();
</script>
