---
import type { DigestItem } from "@singularityfm/core";
import Button from "@singularityfm/design-system/Button";
import Icon from "@singularityfm/design-system/Icon";
import Link from "@singularityfm/design-system/Link";
import { publisherOf } from "../lib/episodeHighlights";
import { headlineParts } from "../lib/format";
import { sourceHost } from "../lib/sourceLabel";
import { idleStoryChip } from "../player/core/readerMath";
import StoryControls from "./StoryControls.astro";

interface Props {
  item: DigestItem;
  /** Reading-order index. The same number the player uses and the one in data-play-item. */
  index: number;
  /** The story's length as "m:ss", or "" while the briefing has no audio. */
  length: string;
  /** Where the story starts in the recording as "m:ss", or "" while the briefing has no audio. */
  at: string;
  hasAudio: boolean;
}

const { item, index, length, at, hasAudio } = Astro.props;
const titleId = `t-${item.id}`;
// Hyphenated words stay whole when the balanced headline wraps (briefing.css).
const words = headlineParts(item.headline);
const idle = idleStoryChip(length, item.headline);
// Null for anything that is not an http or https address: such a story gets no link at all.
const host = sourceHost(item.url);
// The link names the publisher, or the host for an aggregator (episodeHighlights.ts).
const publisher = publisherOf(item.source, host);
---

{/* A story is one line to scan (owner, 2026-11-26: "a lot of text to read ... just show the
     headlines ... with good timestamps ... remove the play buttons for each story"): when it starts
     in the recording, its headline and who published it. The headline opens the summary, the way to
     the source and the votes under it. */}
<article class="story" data-item-id={item.id} data-index={index} aria-labelledby={titleId}>
  {/* The time is the way to hear the story from its start: the player's listener takes it by
       data-play-item and writes its state and name (readerSync.ts), as it did the play mark's.
       Always in the page, hidden while the briefing has no audio timeline, so audio that arrives
       later only has to reveal it and write its time. */}
  <Button
    variant="text"
    className="story-time"
    aria-label={at ? `${at}, ${idle.name}` : idle.name}
    data-play-item={index}
    data-state="idle"
    data-playing="false"
    hidden={!hasAudio}
  >{at}</Button>
  <details class="story-details">
    <summary class="story-head">
      <h3 class="story-title text-title" id={titleId}>
        {words.map((part) => (part.nowrap ? <span class="no-break">{part.text}</span> : part.text))}
      </h3>
      {publisher && <span class="meta story-publisher">{publisher}</span>}
      <Icon name="chevronDown" className="story-chevron" />
    </summary>
    <p class="story-summary">{item.summary}</p>
    <div class="story-actions">
      {/* The way to the story itself, in a new tab. The words are short and the same for every
           story: beside three 44px controls a long publisher's name was cut to "Read at Interface …"
           on a phone, and the name already stands under the headline. The name and the new tab are
           said, not shown. A story whose address must not become a link gets none. */}
      {
        host && (
          <Link
            variant="source"
            className="story-source"
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            title={publisher ?? undefined}
          >
            Read the source
            <span class="sr-only">at {publisher} (opens in a new tab)</span>
          </Link>
        )
      }
      <StoryControls
        id={item.id}
        url={item.url}
        headline={item.headline}
        topic={item.category}
        source={item.source}
        outlet={publisher}
        canBlock={host !== null}
      />
    </div>
  </details>
</article>
