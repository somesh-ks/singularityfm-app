---
import Icon from "@singularityfm/design-system/Icon";
import IconButton from "@singularityfm/design-system/IconButton";
import PlayChip from "@singularityfm/design-system/PlayChip";
import Select from "@singularityfm/design-system/Select";
import type { AlbumOption } from "../lib/catchUps";
import type { AudioMode } from "../lib/digests";
import { AUDIO_UNAVAILABLE_COPY } from "../lib/digestView";
import type { HeroShare } from "../lib/share";
import { type ChipNoun, idleBriefingChip } from "../player/core/readerMath";

interface Props {
  digestId: string;
  mode: AudioMode;
  /** The chip's label before anything plays: "8 min". */
  length: string;
  /** What the chip plays, in its accessible name. */
  noun?: ChipNoun;
  share?: HeroShare;
  /** The day's Catch ups, earliest first, when it has two or more (D219): a select before Play. */
  album?: readonly AlbumOption[];
  /** The item the heart adds to Favorites; absent on a shared page, which has no Favorites. */
  favorite?: string | undefined;
}

const { digestId, mode, length, noun = "podcast", share, album, favorite } = Astro.props;
const chip = idleBriefingChip(length, noun);
const unavailable = mode === "expired" ? AUDIO_UNAVAILABLE_COPY.expired : null;
---

<div class="hero-actions scroll-fade-inline">
  {/* A day's other Catch up (D219): the same select chip as the Library's sort. Choosing one opens
       its page (scripts/catchUpAlbum.ts). Every name stays in the select, so its width is the
       longest name's whichever is shown, and Play beside it never moves. */}
  {
    album && album.length > 1 && (
      <Select variant="tonal" label="Catch up" className="hero-album" data-album-pick data-current={digestId}>
        {album.map((option) => (
          <option value={option.id} selected={option.id === digestId}>
            {option.label}
          </option>
        ))}
      </Select>
    )
  }
  {/* The page's main action: the hero's chip is filled (hero.css). The player owns it once it
       hydrates (readerSync writes its state, label and name). Without audio the chip still works:
       pressing it makes the audio first (narration on Play). Only audio that has expired gets a
       line under it, which the floating Play button below 64rem (PlayFab.astro) points to as well.
       data-minutes is the length as a number, from which a page without audio counts the time left
       where the device left it, as its card does. */}
  <PlayChip
    label={chip.label}
    state="idle"
    reserve="Processing"
    aria-label={chip.name}
    aria-describedby={unavailable ? "play-hint" : undefined}
    data-play-digest={digestId}
    data-noun={noun}
    data-minutes={Number.parseInt(length, 10)}
  />
  {/* Favorites (owner, 2026-11-04): a heart right after Play, the same tonal icon button as Share.
       scripts/briefingPage.ts sets aria-pressed from this device's Favorites and toggles it with a
       toast; the filled heart follows aria-pressed (hero.css). */}
  {
    favorite && (
      <IconButton
        variant="tonal"
        className="hero-favorite"
        label="Favorite"
        aria-pressed="false"
        data-favorite={favorite}
      >
        <Icon name="heartOutline" className="fav-add" /><Icon name="heart" className="fav-remove" />
      </IconButton>
    )
  }
  {/* Share, the page's second action (D153), a secondary icon button after the filled Play (.hero-share in hero.css).
       scripts/briefingPage.ts handles the press; the link is asked for once the page is idle
       (data-share-early, scripts/shareLink.ts), so the share sheet opens inside the first tap. */}
  {
    share && (
      <IconButton
        variant="tonal"
        className="hero-share"
        label="Share"
        data-share={share.path}
        data-share-item={share.item}
        data-share-early={share.item ? "" : undefined}
        data-share-kind={share.kind}
        data-share-of={share.of}
      >
        <Icon name="shareFat" />
      </IconButton>
    )
  }
</div>
{unavailable && <p class="hero-hint" id="play-hint">{unavailable.label}</p>}
