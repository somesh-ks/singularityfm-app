---
import Icon from "@singularityfm/design-system/Icon";
import type { IconSize } from "@singularityfm/design-system/icon";

interface Props {
  size?: IconSize;
}

const { size = "md" } = Astro.props;
---

<span class="swap">
  <Icon name="play" size={size} className="swap-paused" />
  <Icon name="pause" size={size} className="swap-playing" />
</span>
