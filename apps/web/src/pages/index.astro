---
import siteJson from "../../../../site.json" with { type: "json" };
import HomeView from "../components/HomeView.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSite } from "../lib/site";
import { keepAtEdge, readFromContentRepo } from "../server/contentRepo";
import "../styles/home.css";

// Rendered on request from the content repository (D173); the static test build prerenders it.
export const prerender = false;

// singularityfm.app shows the landing page at its root (D398); vercel.json sends its other paths to
// the player's host. Before the content read, so the landing page never waits on the store.
if (!Astro.isPrerendered && Astro.url.host === new URL(siteJson.home).host) {
  return Astro.rewrite("/about");
}

if (!Astro.isPrerendered) {
  const unavailable = await readFromContentRepo("home", Astro.url);
  if (unavailable) return unavailable;
  keepAtEdge(Astro.response.headers);
}

const { entries, episodes } = await getSite();
---

<BaseLayout title="Home" view="home" nav="today" skipLabel="Skip to Home">
  <HomeView entries={entries} episodes={episodes} />
</BaseLayout>
