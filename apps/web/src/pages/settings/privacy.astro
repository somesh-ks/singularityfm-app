---
import Link from "@singularityfm/design-system/Link";
import Switch from "@singularityfm/design-system/Switch";
import SettingsHead from "../../components/SettingsHead.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/settings.css";

const title = "Privacy";
// What this says is the inventory behind docs/specs/analytics.md, D154, D156 and D400: change them together,
// and the date with them.
const updated = "23 November 2026";
---

<BaseLayout title={title} view="settings" skipLabel="Skip to the privacy page">
  <main id="main" tabindex="-1">
    <div class="settings-view" data-settings>
      <SettingsHead up={{ href: "/profile", label: "Profile" }} title={title} />
      <section>
        <h2 class="section-head text-heading">In short</h2>
        <div class="rows card-group">
          <p class="settings-about">
            Singularity has no accounts, no cookies, no ads and no tracking across sites. It counts visits without knowing who you are (unless you choose to help improve it, below), keeps your settings in this browser, and sends a few things you choose to send. Nothing is sold.
          </p>
        </div>
      </section>

      <section>
        <h2 class="section-head text-heading">Visit counts</h2>
        <div class="rows card-group">
          <p class="settings-about">
            Visits are counted by Simple Analytics, a service based in the Netherlands that sets no cookie, stores nothing on your device and does not keep your IP address. It records the page, where you came from (a link shared from here says so), your country from your time zone, your browser and device type, screen size, language, and time and scroll on a page.
          </p>
          <p class="settings-about">
            It also counts a few actions, with no detail about you: sharing, starting, passing halfway and finishing a recording, reading a podcast to the end, opening a story, voting, blocking a source, downloading, installing the app and asking for an episode. If your browser sends Do Not Track or Global Privacy Control, the counting script is never loaded.
          </p>
          <p class="settings-about">
            The same visits and actions also go to <Link href="https://posthog.com/privacy" target="_blank" rel="noopener">PostHog</Link>, on its servers in the European Union, through this site's own address. It too sets no cookie and stores nothing on your device: it tells one visit from another with a code its server makes from your IP address and browser and a secret that changes every day, so your visits on two days cannot be joined.
          </p>
        </div>
      </section>

      <section>
        <h2 class="section-head text-heading">Help improve Singularity</h2>
        <div class="rows card-group">
          <div class="settings-row">
            <label class="settings-label" for="settings-improve">Share how I use the app</label>
            <Switch id="settings-improve" name="improve" />
          </div>
          <p class="settings-about">
            Off unless you turn it on. When on, this browser keeps a random code so PostHog can tell your visits apart over days, and it records how you move through the pages (taps, scrolls and what was on screen) to replay as a video. What you type into a field is hidden from the recording; what the pages show, such as an episode title you saved, is recorded. Turning it off stops the recording and removes the code.
          </p>
        </div>
      </section>

      <section>
        <h2 class="section-head text-heading">Kept in this browser</h2>
        <div class="rows card-group">
          <p class="settings-about">
            Your theme, sounds, volume and speed, where you stopped in each recording, what you have heard, your queue, your Library view and the episodes you download stay on this device. Clearing this site's data in your browser removes them all.
          </p>
        </div>
      </section>

      <section>
        <h2 class="section-head text-heading">What you send</h2>
        <div class="rows card-group">
          <p class="settings-about">
            Votes, stories you open and outlets you stop go to the server, so the podcasts learn what is worth hearing. They name the story, not you, and are never shown to anyone.
          </p>
          <p class="settings-about">
            Categories, sources and episodes are shared: anyone with the link sees them and can change or delete them. What you type for one (an episode title, feedback, a category's name or description) is sent to the AI and search services that write and judge the briefings, such as <Link href="https://www.anthropic.com/legal/privacy" target="_blank" rel="noopener">Anthropic</Link> and <Link href="https://www.firecrawl.dev/privacy-policy" target="_blank" rel="noopener">Firecrawl</Link>, and is kept in the project's private records on <Link href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" target="_blank" rel="noopener">GitHub</Link>. Do not type anything personal into them.
          </p>
          <p class="settings-about">
            When a page fails, it reports the error, the page's path and the site version, with no address and no browser details. What is kept is less: the kind of page (a podcast, not which one), only the start of the error's message, cut before any quote, number, address or line break (where something you typed could appear), and for a blocked file only the site it came from. Each report is deleted after about a week.
          </p>
          <p class="settings-about">
            Playing a podcast aloud sends its text, never anything about you, to <Link href="https://speechify.com/privacy/" target="_blank" rel="noopener">Speechify</Link>, which turns it into speech.
          </p>
          <p class="settings-about">
            Share makes a link anyone can open to hear one podcast or episode. The server keeps the link, when it stops working and how many times it was played, never who played it. A link stops working by itself after 30 days, or sooner if you regenerate the podcast. When the server cannot make a link, Share sends the podcast's own page address instead, which has no expiry.
          </p>
          <p class="settings-about">
            Notifications are off until you turn them on. Then a Catch up or a new take you start gives the server your browser's push address and its two keys, with the run's number, and removes them once the message has gone out, or at the first cleanup after six hours. One message goes through your browser's own push service (Google, Mozilla or Apple), saying only that the podcast is ready. If you turn on Daily or Weekly, the server keeps your browser's push address and its two keys until you turn both off, which asks the server to delete them.
          </p>
          <p class="settings-about">
            When you leave or switch away from a page, it reports how quickly it appeared, held still and answered your taps, with the kind of page (a podcast, not which one), whether your device is touch-first and your connection's speed class. Nothing else is sent, each report is deleted after about a week, and with Do Not Track or Global Privacy Control on, nothing is measured.
          </p>
        </div>
      </section>

      <section>
        <h2 class="section-head text-heading">Hosting</h2>
        <div class="rows card-group">
          <p class="settings-about">
            The site is hosted by <Link href="https://vercel.com/legal/privacy-policy" target="_blank" rel="noopener">Vercel</Link>, whose servers see your IP address to answer each request and may keep it in their logs under its privacy policy. Previewing a source's address uses your IP address, in memory only, to limit how often it can be asked. Audio is served from a public store and deleted after about 120 days.
          </p>
        </div>
      </section>

      <section>
        <h2 class="section-head text-heading">Your rights</h2>
        <div class="rows card-group">
          <p class="settings-about">
            The server has no account that names you, but while Daily or Weekly is on it keeps your browser's push address, which can identify that browser; turning both off asks the server to delete it. To ask about your data or have something you made removed, contact the author through <Link href="https://github.com/somesh-ks">GitHub</Link>. You can also complain to the data protection authority where you live.
          </p>
          <div class="settings-row">
            <span class="settings-label">Last updated</span>
            <span class="settings-hint">{updated}</span>
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  import { IMPROVE_KEY, improving, POSTHOG_TOKEN } from "../../lib/analytics";

  // The switch is kept in this browser; PostHog (loaded at idle by app.ts) is told at once if it has
  // loaded, and reads the choice when it loads otherwise.
  document.addEventListener("astro:page-load", () => {
    const input = document.querySelector<HTMLInputElement>('input[name="improve"]');
    if (!input || input.dataset.wired) return;
    input.dataset.wired = "1";
    input.checked = improving();
    // A browser that asks not to be tracked loads none of it, so the switch would do nothing.
    const nav = navigator as Navigator & { globalPrivacyControl?: boolean };
    if (nav.doNotTrack === "1" || nav.globalPrivacyControl === true) {
      input.checked = false;
      input.disabled = true;
    }
    // The settings rows hide a switch's thumb until its state is known (settings-rows.css).
    input.closest(".settings-view")?.setAttribute("data-ready", "true");
    input.addEventListener("change", () => {
      try {
        if (input.checked) localStorage.setItem(IMPROVE_KEY, "1");
        else localStorage.removeItem(IMPROVE_KEY);
      } catch {
        // Storage blocked: the choice cannot be kept, so nothing changes.
      }
      if (POSTHOG_TOKEN)
        void import("../../scripts/productAnalytics").then((each) => each.setImproving(input.checked));
    });
  });
</script>
