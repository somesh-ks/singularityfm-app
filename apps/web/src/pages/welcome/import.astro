---
import Button from "@singularityfm/design-system/Button";
import Field from "@singularityfm/design-system/Field";
import Icon from "@singularityfm/design-system/Icon";
import FirstRunStep from "../../components/FirstRunStep.astro";
---

<FirstRunStep
  step={3}
  title="Bring your shows"
  about="Coming from another app? Import your list, or skip and add shows later."
  next={null}
>
  {/* The same import as Settings > Import and export (scripts/importPage.ts), and a pasted link as
       on the Add a show page, here without leaving first run. */}
  <section class="first-run-import" data-import-page>
    <div class="rows card-group">
      <button class="row-action" type="button" data-import-pick>
        <span class="settings-text">
          <span class="settings-label">Import a file</span>
          <span class="settings-hint">OPML from Apple Podcasts, Pocket Casts, Overcast</span>
        </span>
        <Icon name="chevronRight" />
      </button>
      <button class="row-action" type="button" aria-expanded="false" aria-controls="first-run-link" data-first-run-paste>
        <span class="settings-text">
          <span class="settings-label">Paste a show link</span>
          <span class="settings-hint">An RSS or Apple Podcasts link</span>
        </span>
        <Icon name="chevronRight" />
      </button>
    </div>
    <form class="first-run-form" id="first-run-link" novalidate hidden data-add-show-form>
      <label class="sr-only" for="add-show-link">Show link</label>
      <Field id="add-show-link" name="link" type="url" inputMode="url" placeholder="https://" autoComplete="off" enterKeyHint="go" data-add-show-input />
      <p class="create-error" role="alert" data-add-show-error hidden></p>
      <Button variant="tonal" type="submit" data-add-show-go>Add show</Button>
    </form>
    <p class="manage-note" role="status" data-import-status hidden></p>
    <ul class="manage-note import-missing" data-import-missing hidden></ul>
    <input class="sr-only" type="file" accept=".opml,.xml,.json,application/json,text/xml,text/x-opml" tabindex="-1" aria-hidden="true" data-import-file />
  </section>
</FirstRunStep>

<script>
  import { installFirstRun } from "../../scripts/firstRunPage";

  installFirstRun();
</script>
