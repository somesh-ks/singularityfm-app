---
import Icon from "@singularityfm/design-system/Icon";
import IconButton from "@singularityfm/design-system/IconButton";
import SearchField from "@singularityfm/design-system/SearchField";
import FirstRunStep from "../../components/FirstRunStep.astro";
import "../../styles/library.css";
import "../../styles/podcast-rows.css";
---

<FirstRunStep
  step={2}
  title="Follow a few shows"
  about="New episodes from your favorites land on Home."
  next="/welcome/import"
>
  {/* Trending in the topics step 1 picked, until a search replaces them. */}
  <form role="search" novalidate data-first-run-search>
    <SearchField
      clearable
      label="Search shows"
      name="q"
      placeholder="Shows and episodes"
      autoComplete="off"
      enterKeyHint="search"
      data-first-run-query
    />
  </form>
  <p class="sr-only" role="status" data-first-run-status></p>
  <div data-library data-view="gallery">
    <ul class="library-grid first-run-shows" role="list" data-first-run-shows></ul>
  </div>
  <p class="manage-note" data-first-run-none hidden>No shows found. Try another name.</p>
  {/* A show as the Library's gallery card, with the heart every show page has: a press favorites
       it at once, a second takes it back (owner's pick over the canvas's ring: no new part). */}
  <template data-first-run-show>
    <li class="card first-run-show" data-card>
      <div class="card-link">
        <span class="cover podcast-cover" data-size="card"><img alt="" decoding="async" loading="lazy" /></span>
        <span class="card-title" data-row-title></span>
        <span class="card-sub"><span class="card-facts" data-row-facts></span></span>
      </div>
      <IconButton variant="tonal" className="first-run-heart" label="Favorite" aria-pressed="false" data-first-run-heart>
        <Icon name="heartOutline" className="fav-add" /><Icon name="heart" className="fav-remove" />
      </IconButton>
    </li>
  </template>
</FirstRunStep>

<script>
  import { installFirstRun } from "../../scripts/firstRunPage";

  installFirstRun();
</script>
