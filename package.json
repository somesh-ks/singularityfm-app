{
  "name": "singularity",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "singularity": "tsx packages/engine/src/cli.ts",
    "typecheck": "pnpm run typecheck:packages && pnpm --filter @singularityfm/web run check && pnpm --filter @singularityfm/admin run check",
    "typecheck:packages": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:fast": "vitest run --exclude '**/git-*.test.ts'",
    "gate": "node scripts/gate.mjs",
    "build": "pnpm --filter @singularityfm/web run build && pnpm --filter @singularityfm/admin run build",
    "dev": "pnpm --filter @singularityfm/web run dev",
    "dev:admin": "pnpm --filter @singularityfm/admin run dev",
    "ds": "tsx node_modules/@singularityfm/design-system/scripts/system/cli.ts",
    "decision:next": "node scripts/nextDecision.mjs",
    "design-check": "vitest run apps/web/src/styles/styles.test.ts scripts/houseRules.test.ts",
    "blast-radius": "node scripts/blastRadius.mjs",
    "glyphs": "tsx scripts/buildGlyphs.ts",
    "emoji": "tsx scripts/buildEmoji.ts",
    "icons": "tsx scripts/buildIcons.ts",
    "prototype": "tsx scripts/buildPrototype.ts",
    "sound-lab": "tsx scripts/buildSoundLab.ts",
    "covers:sheet": "tsx packages/cover/scripts/contactSheet.ts",
    "secrets:push": "tsx scripts/pushSecrets.ts",
    "backfill:opus": "tsx scripts/backfillOpus.ts",
    "vercel:list": "vercel list",
    "vercel:inspect": "vercel inspect",
    "vercel:logs": "vercel logs",
    "vercel:env-list": "vercel env list"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "^1.65.0",
    "@resvg/resvg-js": "^2.6.2",
    "@singularityfm/core": "workspace:*",
    "@singularityfm/design-system": "0.7.0",
    "@types/node": "^26.6.6",
    "@typesafe-ai/sdk": "^0.7.0",
    "emojibase-data": "18.0.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
