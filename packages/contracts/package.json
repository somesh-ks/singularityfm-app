{
  "name": "@singularityfm/contracts",
  "version": "0.1.0",
  "description": "Singularity's store readers and admin session cookie, compiled for apps outside the main repository.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/somesh-ks/singularityfm-app.git",
    "directory": "packages/contracts"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./session": "./src/session.ts",
    "./store": "./src/store.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./session": {
        "types": "./dist/contracts/src/session.d.ts",
        "default": "./dist/contracts/src/session.js"
      },
      "./store": {
        "types": "./dist/contracts/src/store.d.ts",
        "default": "./dist/contracts/src/store.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0"
  }
}
